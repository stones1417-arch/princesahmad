# Core Django settings
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-at-least-64-random-characters
DJANGO_ALLOWED_HOSTS=platform.example.sa
DJANGO_CSRF_TRUSTED_ORIGINS=https://platform.example.sa
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SESSION_COOKIE_AGE=28800
DJANGO_TRUST_PROXY_HEADERS=true
DJANGO_LOG_LEVEL=INFO
DJANGO_CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
DJANGO_CACHE_LOCATION=redis://cache:6379/1

# Production database
DJANGO_DB_ENGINE=postgresql
POSTGRES_DB=princesahmad
POSTGRES_USER=princesahmad
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=database
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
POSTGRES_CONN_MAX_AGE=60

# Authentication controls
ALLOW_PUBLIC_REGISTRATION=false
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=900

# Optional SMS integration
SMS_ENABLED=false
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=
